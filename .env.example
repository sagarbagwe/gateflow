# Local development only. Copy to .env; do not commit .env.
POSTGRES_DB=gateflow
POSTGRES_USER=gateflow
# Replace with a unique local password before starting the database.
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_PORT=5432
# Cache-only Redis. Generate a unique URL-safe (A-Z, a-z, 0-9, _, -) password.
REDIS_PASSWORD=replace-with-a-unique-redis-password
REDIS_PORT=6379
